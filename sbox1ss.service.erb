[Unit]
Description=sbox1ss for <%= uname %>
After=network.target

[Service]
Type=simple
EnvironmentFile=<%= envpath %>
WorkingDirectory=<%= thisdir %>
ExecStart=<%= "#{rakepath} ss_start" %>
User=<%= uname %>
Group=<%= uname %>
Restart=always
RestartSec=5
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
Alias=sbox1ss.<%= uname %>.service


